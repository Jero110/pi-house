#!/bin/sh
# Git exports GIT_DIR, GIT_INDEX_FILE and friends to hooks. Tests that create temporary repos would
# otherwise run git against this repository (one set core.bare=true here). Clear them first.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_PREFIX
npm run check && npm test

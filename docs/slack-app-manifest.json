{
	"display_information": { "name": "pi-house", "description": "Run your private fleet tasks in Slack threads." },
	"features": {
		"bot_user": { "display_name": "pi-house", "always_online": false },
		"app_home": { "home_tab_enabled": false, "messages_tab_enabled": true, "messages_tab_read_only_enabled": false }
	},
	"oauth_config": {
		"scopes": { "bot": ["app_mentions:read", "channels:history", "groups:history", "im:history", "chat:write"] }
	},
	"settings": {
		"socket_mode_enabled": true,
		"event_subscriptions": { "bot_events": ["app_mention", "message.channels", "message.groups", "message.im"] },
		"org_deploy_enabled": false,
		"token_rotation_enabled": false
	}
}
